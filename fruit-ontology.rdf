        <fruit-ontology:grownIn rdf:resource="http://example.org/fruit-ontology#Thailand"/>
        <fruit-ontology:hasColor rdf:resource="http://example.org/fruit-ontology#Green"/>
        <fruit-ontology:name>Durian</fruit-ontology:name>
        <fruit-ontology:sweetness rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</fruit-ontology:sweetness>
    </owl:NamedIndividual>
    


    <!-- http://example.org/fruit-ontology#Green -->

    <owl:NamedIndividual rdf:about="http://example.org/fruit-ontology#Green">
        <rdf:type rdf:resource="http://example.org/fruit-ontology#Color"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/fruit-ontology#Japan -->

    <owl:NamedIndividual rdf:about="http://example.org/fruit-ontology#Japan">
