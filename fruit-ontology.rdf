     -->

    


    <!-- http://example.org/fruit-ontology#Apple -->

    <owl:NamedIndividual rdf:about="http://example.org/fruit-ontology#Apple">
        <rdf:type rdf:resource="http://example.org/fruit-ontology#Fruit"/>
        <fruit-ontology:belongsToCategory rdf:resource="http://example.org/fruit-ontology#Temperate"/>
        <fruit-ontology:grownIn rdf:resource="http://example.org/fruit-ontology#Japan"/>
        <fruit-ontology:hasColor rdf:resource="http://example.org/fruit-ontology#Red"/>
        <fruit-ontology:name>Apple</fruit-ontology:name>
        <fruit-ontology:sweetness rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</fruit-ontology:sweetness>
    </owl:NamedIndividual>
    


    <!-- http://example.org/fruit-ontology#Banana -->

    <owl:NamedIndividual rdf:about="http://example.org/fruit-ontology#Banana">
        <rdf:type rdf:resource="http://example.org/fruit-ontology#Fruit"/>
        <fruit-ontology:belongsToCategory rdf:resource="http://example.org/fruit-ontology#Tropical"/>
        <fruit-ontology:grownIn rdf:resource="http://example.org/fruit-ontology#Thailand"/>
        <fruit-ontology:hasColor rdf:resource="http://example.org/fruit-ontology#Yellow"/>
        <fruit-ontology:name>Banana</fruit-ontology:name>
        <fruit-ontology:sweetness rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</fruit-ontology:sweetness>
    </owl:NamedIndividual>
    


    <!-- http://example.org/fruit-ontology#Durian -->

