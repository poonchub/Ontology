<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/poonchub/ontologies/2569/7/untitled-ontology-15/"
     xml:base="http://www.semanticweb.org/poonchub/ontologies/2569/7/untitled-ontology-15/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:fruit-ontology="http://example.org/fruit-ontology#">
    <owl:Ontology rdf:about="http://example.org/fruit-ontology#"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/fruit-ontology#belongsToCategory -->

    <owl:ObjectProperty rdf:about="http://example.org/fruit-ontology#belongsToCategory">
        <rdfs:domain rdf:resource="http://example.org/fruit-ontology#Fruit"/>
        <rdfs:range rdf:resource="http://example.org/fruit-ontology#FruitCategory"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/fruit-ontology#grownIn -->

    <owl:ObjectProperty rdf:about="http://example.org/fruit-ontology#grownIn">
        <owl:inverseOf rdf:resource="http://example.org/fruit-ontology#growsFruit"/>
        <rdfs:domain rdf:resource="http://example.org/fruit-ontology#Fruit"/>
        <rdfs:range rdf:resource="http://example.org/fruit-ontology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/fruit-ontology#growsFruit -->

    <owl:ObjectProperty rdf:about="http://example.org/fruit-ontology#growsFruit">
        <rdfs:domain rdf:resource="http://example.org/fruit-ontology#Country"/>
        <rdfs:range rdf:resource="http://example.org/fruit-ontology#Fruit"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/fruit-ontology#hasColor -->

    <owl:ObjectProperty rdf:about="http://example.org/fruit-ontology#hasColor">
        <rdfs:domain rdf:resource="http://example.org/fruit-ontology#Fruit"/>
        <rdfs:range rdf:resource="http://example.org/fruit-ontology#Color"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/fruit-ontology#name -->

    <owl:DatatypeProperty rdf:about="http://example.org/fruit-ontology#name">
        <rdfs:domain rdf:resource="http://example.org/fruit-ontology#Fruit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/fruit-ontology#sweetness -->

    <owl:DatatypeProperty rdf:about="http://example.org/fruit-ontology#sweetness">
        <rdfs:domain rdf:resource="http://example.org/fruit-ontology#Fruit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/fruit-ontology#Color -->

    <owl:Class rdf:about="http://example.org/fruit-ontology#Color"/>
    


    <!-- http://example.org/fruit-ontology#Country -->

    <owl:Class rdf:about="http://example.org/fruit-ontology#Country"/>
    


    <!-- http://example.org/fruit-ontology#Fruit -->

    <owl:Class rdf:about="http://example.org/fruit-ontology#Fruit">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/fruit-ontology#belongsToCategory"/>
                <owl:someValuesFrom rdf:resource="http://example.org/fruit-ontology#FruitCategory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/fruit-ontology#grownIn"/>
                <owl:someValuesFrom rdf:resource="http://example.org/fruit-ontology#Country"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/fruit-ontology#hasColor"/>
                <owl:someValuesFrom rdf:resource="http://example.org/fruit-ontology#Color"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/fruit-ontology#FruitCategory -->

    <owl:Class rdf:about="http://example.org/fruit-ontology#FruitCategory"/>
    


    <!-- 
